# Enable Banking application (from https://enablebanking.com/cp/applications)
EB_APP_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
EB_PRIVATE_KEY_PATH=./secrets/enablebanking.pem

# Default country for the bank picker (ISO 3166-1 alpha-2)
EB_COUNTRY=DK

# How far back to fetch transactions on the first sync of an account
EB_HISTORY_DAYS=90

# Local server. Enable Banking requires https redirect URLs for production
# applications, so serve over TLS: `npm run cert` creates a self-signed
# certificate for localhost in secrets/.
PORT=3000
BASE_URL=https://localhost:3000
TLS_CERT_PATH=./secrets/localhost-cert.pem
TLS_KEY_PATH=./secrets/localhost-key.pem

# SQLite database file
DB_PATH=./data/dabba.db
